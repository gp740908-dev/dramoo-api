# ==============================
# DRAMOO - Environment Variables
# ==============================

# App
NODE_ENV=production
PORT=3000
APP_NAME=Dramoo
APP_URL=https://api.dramoo.id

# Security
MASTER_KEY=ganti_dengan_random_string_panjang_minimal_32_karakter
JWT_SECRET=ganti_dengan_jwt_secret_random

# Database
DB_PATH=./data/dramoo.db

# Telegram Bot
TELEGRAM_BOT_TOKEN=ISI_TOKEN_BOT_TELEGRAM_DARI_BOTFATHER
TELEGRAM_ADMIN_ID=ISI_TELEGRAM_USER_ID_ADMIN
TELEGRAM_GROUP_ID=ISI_ID_GROUP_TELEGRAM_KAMU

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000
DAILY_REQUEST_LIMIT=900000

# Saweria (optional, untuk webhook)
SAWERIA_TOKEN=ISI_SAWERIA_TOKEN_KAMU

# Log
LOG_LEVEL=info
